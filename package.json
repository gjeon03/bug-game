{
  "name": "baseboard-empire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Baseboard Empire — a top-down macro-noir strategy-action game about growing a cockroach colony inside a hostile human kitchen.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:nested": "node scripts/serve-nested.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "vite build && playwright test --headed",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm evidence:pack && pnpm evidence:report",
    "evidence:pack": "node scripts/pack-evidence.mjs",
    "evidence:report": "node scripts/report.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.5",
    "@types/three": "^0.185.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "three": "^0.185.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "homepage": "https://gjeon03.github.io/bug-game/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gjeon03/bug-game.git"
  }
}
