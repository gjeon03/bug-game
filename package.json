{
  "name": "whole-home-infestation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "집 전체를 점거하라 — a 3D strategy-action game about expanding a cockroach colony through an occupied Korean apartment.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "precommit": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "test:watch": "vitest",
    "serve:nested": "node scripts/serve-nested.mjs",
    "test:e2e": "node scripts/capture.mjs",
    "capture": "node scripts/capture.mjs",
    "review": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm capture"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.5",
    "@types/three": "^0.185.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjeon03/bug-game.git"
  }
}
